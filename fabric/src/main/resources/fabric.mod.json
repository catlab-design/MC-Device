{
  "schemaVersion": 1,
  "id": "minedevice",
  "version": "${version}",
  "name": "MineDevice",
  "description": "Adds mobile and home phone devices with calling, chat, camera, and optional voice features.",
  "authors": [
    "CatLab Design"
  ],
  "contact": {
    "homepage": "https://dotpp.xyz"
  },
  "license": "PolyForm Noncommercial 1.0.0",
  "icon": "assets/minedevice/mc_device.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.sammy.minedevice.fabric.MinedeviceFabric"
    ],
    "client": [
      "com.sammy.minedevice.fabric.client.MinedeviceFabricClient"
    ],
    "voicechat": [
      "com.sammy.minedevice.voice.svc.MinedeviceSvcPlugin"
    ]
  },
  "mixins": [
    "minedevice.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "architectury": ">=9.2.14",
    "fabric-api": "*"
  },
  "suggests": {
    "plasmovoice": "*",
    "voicechat": "*"
  }
}
